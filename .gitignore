# Python & Environments
__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/

# Node / Frontend
node_modules/
dist/
/package-lock.json

# Logs & temporary files
*.log
logs/*
!logs/.gitkeep
*.zip
.DS_Store
.vscode/
.idea/

# Database files
*.db
*.sqlite
*.sqlite3

# Datasets, weights and generated artefacts are never committed
data/*
data/raf_db/
data/affectnet/
data/sfew/
data/fer2013/
!data/.gitkeep
!data/README*
*.csv
*.tsv

# Image files & numpy caches (ignore all dataset and training images, preserve docs figures)
*.jpg
*.jpeg
*.png
*.bmp
*.npy
*.npz
!docs/**/*

# Weights & models
ml/models/*
!ml/models/.gitkeep
*.pt
*.pth
*.onnx

# Kaggle credentials
kaggle.json
.kaggle/

