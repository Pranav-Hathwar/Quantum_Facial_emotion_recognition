# Copy to .env and adjust. Every value has a default in ml/config.py or backend/app/config.py.
DATASET_PATH=data/fer2013
MODEL_PATH=ml/models
IMAGE_SIZE=224
RESNET_MODE=feature_extractor      # feature_extractor | fine_tuning
N_QUBITS=4
N_Q_LAYERS=2
QUANTUM_BACKEND=default.qubit
LEARNING_RATE=0.001
BATCH_SIZE=32
DEVICE=cpu                         # cpu | cuda
STORE_IMAGES=false                 # privacy default: raw faces are never stored
PROCESS_INTERVAL_MS=500
FACE_DETECTOR=auto                 # auto | yunet | haar

# backend
DATABASE_URL=sqlite:///quantumvision.db        # docker-compose uses PostgreSQL
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@quantumvision.local
ADMIN_PASSWORD=change-this-password
SERVING_MODEL=auto                 # auto | hybrid | classical | control
CORS_ORIGINS=http://localhost:5173
